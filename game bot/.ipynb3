import time
from PIL import ImageGrab, ImageOps
import pyautogui

# ==========================================
# 參數設定區（需依照你的螢幕解析度與瀏覽器調整）
# ==========================================
# 偵測區域的範圍 (x1, y1, x2, y2)
# 代表恐龍前方一小塊用來偵測障礙物的矩形區域
# 建議將 Chrome 瀏覽器縮放比例設為 100%
SEARCH_BOX = (350, 380, 420, 440)


def check_obstacle():
  # 擷取指定區域的畫面
  screen = ImageGrab.grab(bbox=SEARCH_BOX)

  # 轉為灰階影像以加速處理
  gray_screen = ImageOps.grayscale(screen)

  # 取得所有像素資料，尋找是否有深色像素（障礙物）
  # 假設你的瀏覽器是白色背景，障礙物是深灰色/黑色
  pixels = gray_screen.getdata()

  for pixel in pixels:
    # 只要偵測到顏色小於 100（代表有深色物體/障礙物）
    if pixel < 100:
      return True

  return False


def main():
  print('=== 小恐龍自動遊玩程式啟動 ===')
  print('請將 Google Chrome 離線小恐龍畫面打開，並將瀏覽器縮放設為 100%。')
  print('倒數 5 秒後開始，準備好切換視窗...')
  time.sleep(5)
  print('遊戲開始！按 Ctrl + C 可以隨時終止程式。')

  try:
    while True:
      if check_obstacle():
        # 偵測到障礙物，按下空白鍵跳躍
        pyautogui.press('space')
        # 短暫暫停避免連續觸發
        time.sleep(0.04)

      # 降低迴圈頻率以節省 CPU 資源
      time.sleep(0.01)

  except KeyboardInterrupt:
    print('\n程式已手動終止。')


if __name__ == '__main__':
  main()